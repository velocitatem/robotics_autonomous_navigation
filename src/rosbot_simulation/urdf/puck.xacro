<?xml version="1.0"?>
<robot name="puck" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="name" default="puck"/>
  <xacro:arg name="radius" default="0.04"/>
  <xacro:arg name="height" default="0.03"/>
  <xacro:arg name="mass" default="0.05"/>
  <xacro:arg name="r" default="1.0"/>
  <xacro:arg name="g" default="0.0"/>
  <xacro:arg name="b" default="0.0"/>

  <link name="$(arg name)_link">
    <inertial>
      <mass value="$(arg mass)"/>
      <inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="2e-5"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder radius="$(arg radius)" length="$(arg height)"/>
      </geometry>
      <material name="$(arg name)_color">
        <color rgba="$(arg r) $(arg g) $(arg b) 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="$(arg radius)" length="$(arg height)"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <gazebo reference="$(arg name)_link">
    <material>Gazebo/Red</material>
  </gazebo>
</robot>
