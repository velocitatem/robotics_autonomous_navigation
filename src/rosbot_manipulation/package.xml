<?xml version="1.0"?>
<package format="2">
  <name>rosbot_manipulation</name>
  <version>0.1.0</version>
  <description>Gripper control and load-feedback grasp validation for ROSbot.</description>

  <maintainer email="dev@example.com">ROSbot Dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rosbot_competition_msgs</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>

  <exec_depend>rosbot_competition_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <export/>
</package>
