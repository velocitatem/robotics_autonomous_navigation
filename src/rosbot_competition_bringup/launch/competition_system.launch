<launch>
  <arg name="enable_slam" default="true"/>
  <arg name="enable_move_base" default="true"/>
  <arg name="use_slam_toolbox" default="true"/>
  <arg name="use_saved_map" default="false"/>
  <arg name="map_file" default=""/>
  <arg name="enable_ir_safety" default="true"/>
  <arg name="ir_stop_distance" default="0.16"/>
  <arg name="ir_clear_distance" default="0.20"/>
  <arg name="ir_filter_window" default="7"/>
  <arg name="ir_activate_samples" default="4"/>
  <arg name="ir_clear_samples" default="3"/>
  <arg name="enable_laser_nav_safety" default="true"/>
  <arg name="laser_nav_safety_scan_max_age_sec" default="1.2"/>
  <arg name="enable_scan_normalizer" default="false"/>
  <arg name="scan_normalizer_input_topic" default="/scan"/>
  <arg name="scan_normalizer_output_topic" default="/scan_normalized"/>
  <arg name="enable_mission" default="true"/>
  <!-- RViz inspector. Only spawns when both enable_inspector is true AND a
       DISPLAY is available, so headless SSH sessions do not get a Qt crash
       (`qt.qpa.xcb: could not connect to display`) that takes down the node. -->
  <arg name="enable_inspector" default="true"/>
  <!-- Optional extra args, e.g. rviz_args:="-d /path/to/config.rviz" -->
  <arg name="rviz_args" default=""/>
  <arg name="enable_dashboard" default="false"/>
  <arg name="enable_sim_manipulation" default="false"/>

  <include file="$(find rosbot_navigation)/launch/navigation.launch">
    <arg name="enable_slam" value="$(arg enable_slam)"/>
    <arg name="enable_move_base" value="$(arg enable_move_base)"/>
    <arg name="use_slam_toolbox" value="$(arg use_slam_toolbox)"/>
    <arg name="use_saved_map" value="$(arg use_saved_map)"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="enable_ir_safety" value="$(arg enable_ir_safety)"/>
    <arg name="ir_stop_distance" value="$(arg ir_stop_distance)"/>
    <arg name="ir_clear_distance" value="$(arg ir_clear_distance)"/>
    <arg name="ir_filter_window" value="$(arg ir_filter_window)"/>
    <arg name="ir_activate_samples" value="$(arg ir_activate_samples)"/>
    <arg name="ir_clear_samples" value="$(arg ir_clear_samples)"/>
    <arg name="enable_laser_nav_safety" value="$(arg enable_laser_nav_safety)"/>
    <arg name="laser_nav_safety_scan_max_age_sec" value="$(arg laser_nav_safety_scan_max_age_sec)"/>
    <arg name="enable_scan_normalizer" value="$(arg enable_scan_normalizer)"/>
    <arg name="scan_normalizer_input_topic" value="$(arg scan_normalizer_input_topic)"/>
    <arg name="scan_normalizer_output_topic" value="$(arg scan_normalizer_output_topic)"/>
  </include>

  <include file="$(find rosbot_perception)/launch/perception.launch"/>
  <include file="$(find rosbot_manipulation)/launch/manipulation.launch">
    <arg name="use_sim" value="$(arg enable_sim_manipulation)"/>
  </include>
  <include if="$(arg enable_mission)" file="$(find rosbot_mission_control)/launch/mission_controller.launch"/>
  <node if="$(eval str(arg('enable_inspector')).lower() == 'true' and str(optenv('DISPLAY', '')).strip() != '')"
        pkg="rviz" type="rviz" name="competition_inspector"
        args="$(arg rviz_args)" output="screen" required="false"/>
  <include if="$(arg enable_dashboard)" file="$(find rosbot_dashboard)/launch/dashboard.launch"/>
</launch>
