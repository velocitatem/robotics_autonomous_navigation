<launch>
  <arg name="enable_slam" default="true"/>
  <arg name="enable_move_base" default="true"/>
  <arg name="use_slam_toolbox" default="true"/>
  <arg name="use_saved_map" default="false"/>
  <arg name="map_file" default=""/>
  <arg name="enable_ir_safety" default="true"/>
  <arg name="enable_laser_nav_safety" default="true"/>
  <arg name="enable_mission" default="true"/>
  <arg name="enable_inspector" default="true"/>
  <!-- Optional extra args, e.g. rviz_args:="-d /path/to/config.rviz" -->
  <arg name="rviz_args" default=""/>
  <arg name="enable_dashboard" default="false"/>
  <arg name="enable_sim_manipulation" default="false"/>

  <include file="$(find rosbot_navigation)/launch/navigation.launch">
    <arg name="enable_slam" value="$(arg enable_slam)"/>
    <arg name="enable_move_base" value="$(arg enable_move_base)"/>
    <arg name="use_slam_toolbox" value="$(arg use_slam_toolbox)"/>
    <arg name="use_saved_map" value="$(arg use_saved_map)"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="enable_ir_safety" value="$(arg enable_ir_safety)"/>
    <arg name="enable_laser_nav_safety" value="$(arg enable_laser_nav_safety)"/>
  </include>

  <include file="$(find rosbot_perception)/launch/perception.launch"/>
  <include file="$(find rosbot_manipulation)/launch/manipulation.launch">
    <arg name="use_sim" value="$(arg enable_sim_manipulation)"/>
  </include>
  <include if="$(arg enable_mission)" file="$(find rosbot_mission_control)/launch/mission_controller.launch"/>
  <node if="$(arg enable_inspector)" pkg="rviz" type="rviz" name="competition_inspector" args="$(arg rviz_args)" output="screen"/>
  <include if="$(arg enable_dashboard)" file="$(find rosbot_dashboard)/launch/dashboard.launch"/>
</launch>
