<?xml version="1.0"?>
<package format="2">
  <name>rosbot_navigation</name>
  <version>0.1.0</version>
  <description>Navigation stack integration for ROSbot competition.</description>

  <maintainer email="dev@example.com">ROSbot Dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>geometry_msgs</build_depend>
