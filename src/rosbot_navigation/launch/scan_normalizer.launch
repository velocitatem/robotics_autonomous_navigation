<launch>
  <!--
    Republish a beam-count-stable scan stream for slam_toolbox / Karto.

    Defaults: subscribe to /scan from the lidar driver and publish a
    normalized copy on /scan_normalized. competition_system.launch will
    automatically point slam_toolbox at /scan_normalized when
    enable_scan_normalizer:=true.
  -->
  <arg name="input_topic" default="/scan"/>
  <arg name="output_topic" default="/scan_normalized"/>
  <arg name="expected_count" default="0"/>
  <arg name="fix_count" default="true"/>

  <node pkg="rosbot_navigation" type="scan_normalizer.py"
        name="scan_normalizer" output="screen">
    <param name="input_topic" value="$(arg input_topic)"/>
    <param name="output_topic" value="$(arg output_topic)"/>
    <param name="expected_count" value="$(arg expected_count)"/>
    <param name="fix_count" value="$(arg fix_count)"/>
  </node>
</launch>
