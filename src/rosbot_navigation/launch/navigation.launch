<launch>
  <arg name="enable_slam" default="true"/>
  <arg name="enable_move_base" default="true"/>
  <arg name="use_slam_toolbox" default="true"/>
  <arg name="use_saved_map" default="false"/>
  <arg name="map_file" default=""/>
  <arg name="enable_ir_safety" default="true"/>
  <arg name="ir_stop_distance" default="0.16"/>
  <arg name="ir_clear_distance" default="0.20"/>
  <arg name="ir_filter_window" default="7"/>
  <arg name="ir_activate_samples" default="4"/>
  <arg name="ir_clear_samples" default="3"/>
  <arg name="enable_laser_nav_safety" default="true"/>
  <arg name="laser_nav_safety_scan_max_age_sec" default="1.2"/>
  <!-- When the lidar driver publishes inconsistent beam counts (e.g. 1946 vs
       1947), enable this to normalize /scan before slam_toolbox sees it.
       The normalizer subscribes to /scan and republishes /scan_normalized,
       and slam_toolbox is automatically pointed at the normalized topic.
       Other consumers keep reading /scan and tolerate variable beam counts. -->
  <arg name="enable_scan_normalizer" default="false"/>
  <arg name="scan_normalizer_input_topic" default="/scan"/>
  <arg name="scan_normalizer_output_topic" default="/scan_normalized"/>
  <arg name="slam_scan_topic"
       default="$(eval arg('scan_normalizer_output_topic') if str(arg('enable_scan_normalizer')).lower() == 'true' else '/scan')"/>

  <include if="$(arg enable_scan_normalizer)"
           file="$(find rosbot_navigation)/launch/scan_normalizer.launch">
    <arg name="input_topic" value="$(arg scan_normalizer_input_topic)"/>
    <arg name="output_topic" value="$(arg scan_normalizer_output_topic)"/>
  </include>

  <include if="$(eval str(arg('enable_slam')).lower() == 'true' and str(arg('use_saved_map')).lower() != 'true')" file="$(find rosbot_navigation)/launch/slam.launch">
    <arg name="use_slam_toolbox" value="$(arg use_slam_toolbox)"/>
    <arg name="scan_topic" value="$(arg slam_scan_topic)"/>
  </include>

  <group if="$(arg use_saved_map)">
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen"/>

    <node pkg="amcl" type="amcl" name="amcl" output="screen">
      <param name="odom_frame_id" value="odom"/>
      <param name="base_frame_id" value="base_link"/>
      <param name="global_frame_id" value="map"/>
      <param name="odom_model_type" value="diff-corrected"/>
      <param name="tf_broadcast" value="true"/>
      <param name="update_min_d" value="0.05"/>
      <param name="update_min_a" value="0.10"/>
      <param name="min_particles" value="200"/>
      <param name="max_particles" value="1000"/>
    </node>
  </group>

  <include if="$(arg enable_move_base)" file="$(find rosbot_navigation)/launch/move_base.launch">
    <arg name="enable_laser_nav_safety" value="$(arg enable_laser_nav_safety)"/>
    <arg name="laser_nav_safety_scan_max_age_sec" value="$(arg laser_nav_safety_scan_max_age_sec)"/>
    <arg name="map_service" value="$(eval '/static_map' if str(arg('use_saved_map')).lower() == 'true' else ('/slam_toolbox/dynamic_map' if str(arg('use_slam_toolbox')).lower() == 'true' else '/static_map'))"/>
  </include>
  <include file="$(find rosbot_navigation)/launch/twist_mux.launch">
    <arg name="enable_ir_safety" value="$(arg enable_ir_safety)"/>
    <arg name="ir_stop_distance" value="$(arg ir_stop_distance)"/>
    <arg name="ir_clear_distance" value="$(arg ir_clear_distance)"/>
    <arg name="ir_filter_window" value="$(arg ir_filter_window)"/>
    <arg name="ir_activate_samples" value="$(arg ir_activate_samples)"/>
    <arg name="ir_clear_samples" value="$(arg ir_clear_samples)"/>
  </include>
</launch>
