<launch>
  <arg name="use_slam_toolbox" default="true"/>
  <!-- Allow upstream launches to redirect SLAM to a normalized scan topic
       (e.g. /scan_normalized from rosbot_navigation/scan_normalizer.py)
       when the lidar driver publishes inconsistent beam counts. Other
       consumers (move_base, safety, mission control) keep reading /scan. -->
  <arg name="scan_topic" default="/scan"/>

  <group if="$(arg use_slam_toolbox)">
    <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
      <param name="odom_frame" value="odom"/>
      <param name="map_frame" value="map"/>
      <param name="base_frame" value="base_link"/>
      <param name="scan_topic" value="$(arg scan_topic)"/>
      <param name="mode" value="mapping"/>
      <param name="solver_plugin" value="solver_plugins::CeresSolver"/>
      <param name="resolution" value="0.05"/>
      <param name="publish_map" value="true"/>
      <param name="map_update_interval" value="0.6"/>
      <param name="transform_publish_period" value="0.05"/>
      <param name="minimum_time_interval" value="0.08"/>
      <!-- Make scan integration robust to distributed-network TF jitter and
           ensure mapping starts from the first scans instead of waiting for
           large motion before emitting /map. -->
      <param name="transform_timeout" value="0.5"/>
      <param name="tf_buffer_duration" value="30.0"/>
      <param name="minimum_travel_distance" value="0.0"/>
      <param name="minimum_travel_heading" value="0.0"/>
    </node>

    <!-- move_base static_layer expects /static_map service, while
         slam_toolbox exposes /slam_toolbox/dynamic_map. Bridge them so
         move_base can complete costmap initialization and advertise action topics. -->
    <node pkg="rosbot_navigation" type="static_map_proxy.py" name="static_map_proxy" output="screen">
      <param name="service_name" value="/static_map"/>
      <param name="target_service" value="/slam_toolbox/dynamic_map"/>
      <param name="map_topic" value="/map"/>
      <param name="use_target_service" value="false"/>
    </node>
  </group>

  <group unless="$(arg use_slam_toolbox)">
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
      <param name="base_frame" value="base_link"/>
      <param name="odom_frame" value="odom"/>
      <param name="map_update_interval" value="2.0"/>
      <param name="maxUrange" value="6.0"/>
      <param name="xmin" value="-10.0"/>
      <param name="ymin" value="-10.0"/>
      <param name="xmax" value="10.0"/>
      <param name="ymax" value="10.0"/>
      <param name="delta" value="0.05"/>
    </node>
  </group>
</launch>
